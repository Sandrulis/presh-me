# =============================================================================
# Presh — environment variables
# Copy to .env.local and fill in values from Supabase Dashboard.
# =============================================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3130

# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server only — NEVER expose in browser or commit real value
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: dedicated HMAC secret for booking calendar feed tokens (else uses service_role)
# BOOKING_CALENDAR_SECRET=

# Database password — only for local migrations (npm run db:migrate)
# Dashboard → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your_database_password
# Pooler region (Dashboard → Database → Connection string), default eu-west-1
# SUPABASE_DB_REGION=eu-west-1
# Or full connection string if pooler region differs:
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Own Google OAuth (fallback; preferred: Admin → Integrācijas) ---
# Google Cloud → Credentials → OAuth 2.0 Client
# Redirect: {NEXT_PUBLIC_SITE_URL}/auth/callback
# GOOGLE_CLIENT_ID=123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
